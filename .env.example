# Copy this file to .env and set your own values. Never commit .env.

# Shared password for the tracker (at least 8 characters).
TRACKER_PASSWORD=

# Folder on the host where the SQLite database is stored.
DATA_PATH=/mnt/user/appdata/packing-tracker

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Address phones use to open the tracker. QR codes on labels point here.
# Use your Unraid server's IP or hostname, e.g. http://192.168.1.50:5639
# Leave empty to use whatever address you print from.
PUBLIC_URL=
